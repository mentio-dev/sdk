{
  "name": "@mentio-dev/sdk",
  "version": "0.3.2",
  "description": "TypeScript SDK for the Mentio API, generated from its OpenAPI document.",
  "license": "MIT",
  "homepage": "https://docs.mentio.dev/sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mentio-dev/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mentio-dev/sdk/issues"
  },
  "keywords": [
    "mentio",
    "social listening",
    "brand monitoring",
    "sdk",
    "api client",
    "openapi"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "export-openapi": "tsx scripts/export-openapi.ts",
    "generate": "pnpm export-openapi && openapi-ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
